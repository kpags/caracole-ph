generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DesignerReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CartOwnerType {
  REGISTERED
  SESSION
}

enum CartStatus {
  ACTIVE
  ABANDONED
}

enum CustomerSource {
  WEBSITE
  SHOPIFY
}

enum CustomerSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum InquiryStatus {
  PENDING
  ENDORSED
  SPAM
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  email             String         @unique @db.VarChar(320)
  firstName         String?        @map("first_name") @db.VarChar(100)
  lastName          String?        @map("last_name") @db.VarChar(100)
  password          String
  isDesigner        Boolean        @default(false) @map("is_designer")
  isStaff           Boolean        @default(false) @map("is_staff")
  isSuperuser       Boolean        @default(false) @map("is_superuser")
  isActive          Boolean        @default(true) @map("is_active")
  isEmailVerified   Boolean        @default(false) @map("is_email_verified")
  designer          Designer?
  customer          Customer?
  reviewedDesigners Designer[]      @relation("DesignerReviewedBy")
  refreshTokens     RefreshToken[]
  otpCodes          OtpCode[]

  @@index([isActive, isEmailVerified, isDesigner, isStaff, isSuperuser, createdAt])
  @@map("users")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  userId              String         @unique @map("user_id") @db.Uuid
  shopifyId           String?        @unique @map("shopify_id")
  source              CustomerSource @default(SHOPIFY)
  phone               String?        @db.VarChar(60)
  shopifyState        String?        @map("shopify_state") @db.VarChar(40)
  shopifyVerifiedEmail Boolean?      @map("shopify_verified_email")
  orderCount          Int            @default(0) @map("order_count")
  amountSpent         Decimal?       @map("amount_spent") @db.Decimal(14, 2)
  currencyCode        String?        @map("currency_code") @db.VarChar(3)
  tags                String[]       @default([])
  defaultAddress      Json?          @map("default_address")
  shopifyCreatedAt    DateTime?      @map("shopify_created_at") @db.Timestamptz(6)
  shopifyUpdatedAt    DateTime?      @map("shopify_updated_at") @db.Timestamptz(6)
  lastSyncedAt        DateTime?      @map("last_synced_at") @db.Timestamptz(6)
  legacyInvitationSentAt DateTime?   @map("legacy_invitation_sent_at") @db.Timestamptz(6)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([lastSyncedAt])
  @@map("customers")
}

model CustomerSyncRun {
  id            String             @id @default(uuid()) @db.Uuid
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(6)
  status        CustomerSyncStatus @default(RUNNING)
  fetchedCount  Int                @default(0) @map("fetched_count")
  createdCount  Int                @default(0) @map("created_count")
  updatedCount  Int                @default(0) @map("updated_count")
  conflictCount Int                @default(0) @map("conflict_count")
  removedCount  Int                @default(0) @map("removed_count")
  error         String?

  @@index([startedAt])
  @@map("customer_sync_runs")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  email     String   @unique @db.VarChar(320)

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model Inquiry {
  id            String        @id @default(uuid()) @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  firstName     String        @map("first_name") @db.VarChar(100)
  lastName      String        @map("last_name") @db.VarChar(100)
  email         String        @db.VarChar(320)
  contactNumber String        @map("contact_number") @db.VarChar(60)
  message       String        @db.Text
  productName   String?       @map("product_name") @db.VarChar(255)
  edpNumber     String?       @map("edp_number") @db.VarChar(120)
  articleNumber String?       @map("article_number") @db.VarChar(120)
  status        InquiryStatus @default(PENDING)

  @@index([status, createdAt])
  @@index([email])
  @@index([productName, createdAt])
  @@index([edpNumber, createdAt])
  @@index([articleNumber, createdAt])
  @@map("inquiries")
}

model Designer {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  userId       String    @unique @map("user_id") @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  birthdate    DateTime  @db.Date
  mobileNumber String    @map("mobile_number") @db.VarChar(13)
  company      String?
  officeAddress String?  @map("office_address")
  companyWebsite String? @map("company_website")
  touchpoint   String
  howDidYouHearAboutUs String @map("how_did_you_hear_about_us")
  reviewStatus  DesignerReviewStatus @default(PENDING) @map("review_status")
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedById  String?   @map("reviewed_by_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("DesignerReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@map("designers")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  purpose   OtpPurpose
  codeHash  String     @map("code_hash")
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts  Int        @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model HeroBanner {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  title       String   @db.VarChar(80)
  subtitle    String?  @db.VarChar(120)
  description String   @db.VarChar(200)
  category    String   @db.VarChar(80)
  mediaUrl    String   @map("media_url")
  mediaType   String   @map("media_type") @db.VarChar(10)
  position    Int      @unique

  @@index([position])
  @@map("hero_banners")
}

model ShopTheLookEnvironment {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  name          String   @db.VarChar(120)
  imageUrl      String   @map("image_url")
  imageFileName String   @map("image_file_name") @db.VarChar(255)
  description   String   @default("")
  position      Int      @unique
  hotspots      Json     @default("[]")

  @@index([position])
  @@map("shop_the_look_environments")
}

model MainCategoryDisplay {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  name      String   @unique @db.VarChar(80)
  imageUrl  String   @map("image_url")

  @@map("main_category_displays")
}

model DesignerProfile {
  id                String                    @id @default(uuid()) @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  slug              String                    @unique @db.VarChar(180)
  name              String                    @db.VarChar(160)
  link              String?
  tagline           String                    @db.VarChar(100)
  briefStory        String                    @map("brief_story") @db.VarChar(300)
  thumbnailImageUrl String                    @map("thumbnail_image_url")
  headerImageUrl    String                    @map("header_image_url")
  isFeatured        Boolean                   @default(false) @map("is_featured")
  featuredProducts  DesignerFeaturedProduct[]

  @@index([isFeatured])
  @@map("designer_profiles")
}

model DesignerFeaturedProduct {
  id                String          @id @default(uuid()) @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  designerProfileId String          @map("designer_profile_id") @db.Uuid
  name              String          @db.VarChar(160)
  shortDescription  String          @map("short_description") @db.VarChar(150)
  lifestyleImageUrl String          @map("lifestyle_image_url")
  position          Int
  designerProfile   DesignerProfile @relation(fields: [designerProfileId], references: [id], onDelete: Cascade)

  @@unique([designerProfileId, position])
  @@index([designerProfileId])
  @@map("designer_featured_products")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  shopifyId         String   @unique @map("shopify_id")
  handle            String   @unique
  vendor            String
  title             String
  description       String   @default("")
  descriptionHtml   String   @default("") @map("description_html")
  productType       String   @default("") @map("product_type")
  tags              String[] @default([])
  status            String
  seoTitle          String?  @map("seo_title")
  seoDescription    String?  @map("seo_description")
  mainCategory      String?  @map("main_category")
  subcategory       String?
  sku               String?
  price             Decimal? @db.Decimal(14, 2)
  currencyCode      String?  @map("currency_code") @db.VarChar(3)
  availableForSale  Boolean  @default(false) @map("available_for_sale")
  totalInventory    Int?     @map("total_inventory")
  featuredImageUrl  String?  @map("featured_image_url")
  featuredImageAlt  String?  @map("featured_image_alt")
  images            Json     @default("[]")
  options           Json     @default("[]")
  variants          Json     @default("[]")
  media             Json     @default("[]")
  metafields        Json     @default("{}")
  attributeValues   ProductAttributeValue[]
  shopifyData       Json     @map("shopify_data")
  shopifyCreatedAt  DateTime? @map("shopify_created_at") @db.Timestamptz(6)
  shopifyUpdatedAt  DateTime? @map("shopify_updated_at") @db.Timestamptz(6)
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  isActive          Boolean  @default(true) @map("is_active")
  lastSyncedAt      DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, mainCategory])
  @@index([isActive, subcategory])
  @@index([isActive, publishedAt])
  @@map("products")
}

model Attribute {
  id              String                  @id @default(uuid()) @db.Uuid
  key             String                  @unique @db.VarChar(80)
  name            String                  @unique @db.VarChar(120)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  productValues   ProductAttributeValue[]

  @@map("attributes")
}

model ProductAttributeValue {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  value       String
  numericValue Float?   @map("numeric_value")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@index([attributeId, numericValue])
  @@map("product_attribute_values")
}

model CatalogSyncRun {
  id               String    @id @default(uuid()) @db.Uuid
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  status           String
  fetchedCount     Int       @default(0) @map("fetched_count")
  createdCount     Int       @default(0) @map("created_count")
  updatedCount     Int       @default(0) @map("updated_count")
  deactivatedCount Int       @default(0) @map("deactivated_count")
  error            String?

  @@index([startedAt])
  @@map("catalog_sync_runs")
}

model Cart {
  id                String        @id @default(uuid()) @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerKey          String        @unique @map("owner_key") @db.VarChar(360)
  ownerType         CartOwnerType @map("owner_type")
  status            CartStatus    @default(ACTIVE) @map("status")
  sessionId         String        @map("session_id") @db.VarChar(180)
  customerEmail     String?       @map("customer_email") @db.VarChar(320)
  customerFirstName String?       @map("customer_first_name") @db.VarChar(100)
  customerLastName  String?       @map("customer_last_name") @db.VarChar(100)
  items             Json          @default("[]")
  itemCount         Int           @default(0) @map("item_count")
  totalPrice        Decimal       @default(0) @map("total_price") @db.Decimal(14, 2)
  currencyCode      String        @default("PHP") @map("currency_code") @db.VarChar(3)

  @@index([ownerType, itemCount, createdAt])
  @@index([ownerType, itemCount, updatedAt])
  @@index([status, updatedAt])
  @@index([customerEmail])
  @@map("carts")
}
