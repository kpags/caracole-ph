{
  "name": "caracole-ph-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:seed-system-admin": "node scripts/seed-system-administrator.js",
    "db:deploy": "prisma migrate deploy && npm run db:seed-system-admin && npm run db:seed-initial-designers && npm run db:seed-showrooms && npm run db:seed-email-notification-recipients && node -e \"console.log('Database migrations and system-administrator seed completed successfully.')\"",
    "db:purge-rejected-designers": "node scripts/delete-rejected-designers.js",
    "db:purge-pending-customers": "node scripts/delete-pending-customers.js",
    "carts:abandon-inactive": "node scripts/abandon-inactive-carts.js",
    "db:seed-initial-designers": "node scripts/seed-initial-designers.js",
    "db:seed-showrooms": "node scripts/seed-showrooms.js",
    "db:seed-email-notification-recipients": "node scripts/seed-email-notification-recipients.js",
    "shopify:sync-products": "node scripts/sync-shopify-products.js",
    "shopify:sync-customers": "node scripts/sync-shopify-customers.js",
    "customers:migrate-to-shopify": "node scripts/migrate-local-customers-to-shopify.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/lib-storage": "^3.1108.0",
    "@prisma/client": "^6.14.0",
    "@shopify/storefront-api-client": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.5",
    "prisma": "^6.14.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.0.17"
  }
}
