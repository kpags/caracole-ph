# PostgreSQL (used by the db container)
POSTGRES_DB=caracole
POSTGRES_USER=caracole
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

# API
API_PORT=3000
VITE_API_URL=http://localhost:3000
ADMIN_PORT=8080
DATABASE_URL=postgresql://caracole:change-this-postgres-password@db:5432/caracole?schema=public
CORS_ORIGIN=http://localhost:5173
APP_NAME=Caracole PH

# Authentication
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Caracole PH <no-reply@example.com>

# Cloudflare R2 website media storage
# Create a bucket-scoped R2 API token with Object Read & Write permissions.
# Point PUBLIC_BASE_URL to the custom domain attached to the R2 bucket.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://media.example.com

# Optional first superuser. Leave both blank to skip seeding.
SEED_SUPERUSER_EMAIL=
SEED_SUPERUSER_PASSWORD=
