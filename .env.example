# Escape a literal $ in any value as $$ (or use single quotes) so Docker Compose does not interpolate it.

# PostgreSQL (used by the db container)
POSTGRES_DB=caracole
POSTGRES_USER=caracole
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

# API
API_PORT=3000
# Browser address used by the Nuxt storefront. Docker Compose supplies the
# private `http://api:3000` URL for SSR requests automatically.
CLIENT_PORT=5173
VITE_API_URL=http://localhost:3000
# Public API address used by the Nuxt storefront. VITE_API_URL remains for
# compatibility with existing Vue development tooling.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Private SSR address. Docker Compose overrides this with http://api:3000.
NUXT_API_INTERNAL_BASE_URL=http://localhost:3000
ADMIN_PORT=8080
ADMIN_API_URL=http://localhost:3000
DATABASE_URL=postgresql://caracole:change-this-postgres-password@db:5432/caracole?schema=public
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
APP_NAME=Caracole PH

# Authentication
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Caracole PH <no-reply@example.com>
# Optional one-time initial To recipients for General and Product Inquiry. After deployment,
# manage all recipients in Admin → Emailing; saved database values are used at send time.
INQUIRY_RECEIVERS=
# Optional one-time initial To recipients for Designer Registration. After deployment,
# manage all recipients in Admin → Emailing; saved database values are used at send time.
DESIGNER_REGISTRATION_RECEIVERS=
# URL included in designer-registration notifications for the Caracole admin team.
ADMIN_DASHBOARD_URL=http://localhost:8080
# Destination for admin-invitation links. The invite expires after seven days by default.
ADMIN_INVITATION_SETUP_URL=http://localhost:8080/admin/setup-password
ADMIN_INVITATION_EXPIRES_IN=7d

# Local-only Prisma Studio database browser (included in normal Compose commands).
PRISMA_STUDIO_PORT=5555

# Cloudflare R2 website media storage
# Create a bucket-scoped R2 API token with Object Read & Write permissions.
# Point PUBLIC_BASE_URL to the custom domain attached to the R2 bucket.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Shopify Storefront catalog (server-only; never prefix these with VITE_)
# Enable unauthenticated product listing access and expose custom.categories to the Storefront API.
SHOPIFY_STORE_DOMAIN=dexterton-2.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_PRIVATE_ACCESS_TOKEN=
# Dev Dashboard app credentials. The scheduled sync exchanges these for a short-lived Admin API token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_VENDOR=Caracole
SHOPIFY_PRODUCT_CATEGORY_METAFIELD_NAMESPACE=custom
SHOPIFY_PRODUCT_CATEGORY_METAFIELD_KEY=categories

# Optional first superuser. Leave both blank to skip seeding.
SEED_SUPERUSER_EMAIL=
SEED_SUPERUSER_PASSWORD=
